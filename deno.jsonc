{
  "name": "@usu/pathisync",
  "version": "2.1.0",
  "license": "MIT",
  "exports": "./main.ts",
  "tasks": {
    "test": "deno test -A --no-check=remote tests/",
    "check": "deno fmt --check && deno lint && deno check main.ts tasks/*.ts tests/*.ts",
    "roundtrip": "deno run --allow-read tasks/roundtrip.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "diff": "npm:diff@^8.0.4",
    "inquirer": "npm:inquirer@^9.3.8",
    // Tests only: checks that generated declarations type-check.
    "typescript": "npm:typescript@^5.9.2"
  },
  "fmt": {
    "exclude": ["docs/", "tests/fixtures/"]
  },
  "lint": {
    "exclude": ["docs/", "tests/fixtures/"]
  },
  "publish": {
    "exclude": ["tests/", "tasks/", "docs/", ".github/", ".vscode/"]
  }
}
